[Unit]
Description=Run the Hirfaty production media backup daily

[Timer]
# Offset from the database dump's 02:30 (hirfaty-backup.timer) so the two
# don't compete for disk/CPU at once — media archiving reads a lot more data.
OnCalendar=*-*-* 02:45:00
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
