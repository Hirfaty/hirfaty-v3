# Paired with hirfaty-backup.timer. Install both:
#   sudo cp docker/systemd/hirfaty-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hirfaty-backup.timer
#
# Each run encrypts the database dump, the photo archive and the checkout's
# untracked config on this machine and streams them to one dated folder in
# Cloudflare R2, under prod/ — see docker/scripts/backup.sh, which needs
# /etc/hirfaty/backup.env (docker/scripts/backup.env.example). Retention is the
# bucket's: a 30-day lock and a lifecycle rule deleting at 35 days.
# Check history with: systemctl status hirfaty-backup.service
#                      journalctl -u hirfaty-backup.service
#
# Production only — see hirfaty-staging-backup.service for staging's
# optional counterpart.
# Runs as root so it can read /etc/hirfaty/backup.env.

[Unit]
Description=Backup the Hirfaty production database and photos
After=hirfaty.service

[Service]
Type=oneshot
WorkingDirectory=/home/hirfaty/prod-hirfaty
ExecStart=/usr/bin/make prod-backup
# A oneshot left hanging would stop every later night from starting. Being killed
# counts as a failure, which the script reports.
TimeoutStartSec=6h
