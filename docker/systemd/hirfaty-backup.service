# Paired with hirfaty-backup.timer. Install both:
#   sudo cp docker/systemd/hirfaty-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hirfaty-backup.timer
#
# Each run writes one dated folder to /var/backups/hirfaty holding the
# database dump AND the photo archive (database.sql.gz + media.tar.gz), and
# keeps the newest 30 — see docker/scripts/backup.sh. This one unit replaced
# the separate hirfaty-backup-media.* pair, which kept only 2 of each.
# Check history with: systemctl status hirfaty-backup.service
#                      journalctl -u hirfaty-backup.service
#
# Production only — see hirfaty-staging-backup.service for staging's
# optional counterpart.
# Runs as root so it can write to /var/backups.

[Unit]
Description=Backup the Hirfaty production database and photos
After=hirfaty.service

[Service]
Type=oneshot
WorkingDirectory=/home/hirfaty/prod-hirfaty
ExecStart=/usr/bin/make prod-backup
