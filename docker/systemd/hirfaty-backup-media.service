# Paired with hirfaty-backup-media.timer. Install both:
#   sudo cp docker/systemd/hirfaty-backup-media.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hirfaty-backup-media.timer
#
# Archives land in /var/backups/hirfaty, alongside the database dumps from
# hirfaty-backup.service — same directory, same keep-last-2 rotation, just a
# `hirfaty-media-*.tar.gz` name instead of `hirfaty-*.sql.gz`.
# Check history with: systemctl status hirfaty-backup-media.service
#                      journalctl -u hirfaty-backup-media.service
#
# Production only — see hirfaty-staging-backup-media.service for staging's
# optional counterpart.
# Runs as root so it can write to /var/backups.

[Unit]
Description=Backup the Hirfaty production media (SeaweedFS)
After=hirfaty.service

[Service]
Type=oneshot
WorkingDirectory=/home/hirfaty/prod-hirfaty
ExecStart=/usr/bin/make prod-backup-media
