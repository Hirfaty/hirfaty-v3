# Settings for docker/scripts/backup.sh and restore.sh. Install on the server:
#
#   sudo install -d -m 700 -o root -g root /etc/hirfaty
#   sudo install -m 600 -o root -g root docker/scripts/backup.env.example /etc/hirfaty/backup.env
#   sudo nano /etc/hirfaty/backup.env
#
# Root-only and kept away from the app's .env, which is injected into the
# containers. Both scripts refuse to run if this file is readable by anyone else.

# The bucket's Settings page shows its S3 API URL: keep it up to ".com", without
# the bucket name.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# An R2 API token with "Object Read & Write", limited to this one bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hirfaty-backups

# The PUBLIC key only (age1...), printed by `age-keygen`. The private key
# (AGE-SECRET-KEY-1...) never goes on this server: the scripts refuse to run if
# they find one in this file.
AGE_RECIPIENT=

# Optional, one check per environment (healthchecks.io or anything with the same
# convention): the URL is called after a success and <url>/fail after a failure.
# Have it alert when no success arrives for 26 hours. A monitor is needed because
# the bucket's lifecycle rule keeps deleting old backups if new ones stop coming.
BACKUP_HEARTBEAT_URL=
BACKUP_HEARTBEAT_URL_STAGING=
