# Copy to plain `.env` in the staging checkout
# (`cp .env.staging.example .env`), fill in the blanks, then run
# `make stage-build && make stage-key-generate` and paste the result into
# APP_KEY. Named `.env` — not `.env.staging` — deliberately: this lives in a
# completely separate checkout from prod's `.env`, and Compose's own
# ${VAR:-default} interpolation only ever reads a file literally named
# `.env`, never whatever `env_file:` points at.
#
# Consumed by docker-compose.staging.yml via `env_file: .env` (that
# directive AND the ${VAR:-default} defaults elsewhere in that file both
# need this exact filename), so DB_HOST/SEAWEEDFS_ENDPOINT use compose
# service names ("db", "seaweedfs").
#
# APP_KEY, DB_PASSWORD and the SeaweedFS keys MUST differ from production's.
# Sharing APP_KEY in particular would let a staging compromise decrypt
# production session cookies.

APP_NAME=Hirfaty
# Not "production" — this is what disables Laravel's destructive-command guard
# (DB::prohibitDestructiveCommands) and the strict Password::defaults rules,
# so migrate:fresh and weak test passwords work here without any overrides.
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://init.hirfaty.com
APP_DOMAIN=init.hirfaty.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Louder than production's `error`, since staging exists to surface problems.
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=hirfaty
DB_USERNAME=hirfaty
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Matches production (see .env.production.example) so staging rehearses the
# same configuration rather than diverging in a way only prod discovers.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=init.hirfaty.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=seaweedfs
QUEUE_CONNECTION=database

CACHE_STORE=database

# Staging must NOT send real mail to real sellers/buyers. Mailtrap's sandbox
# captures everything in a test inbox and delivers nothing outward, which is
# exactly what you want here — unlike production, which uses Resend.
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="staging@hirfaty.com"
MAIL_FROM_NAME="${APP_NAME} (staging)"

VITE_APP_NAME="${APP_NAME}"

AUTH_DEFAULT_PASSWORD=

ADMIN_AUTH_DEFAULT_EMAIL=admin@hirfaty.com
ADMIN_AUTH_DEFAULT_PASSWORD=

GLOBAL_DELIVERY_FEE=20

# Staging's own SeaweedFS volume — separate from production's, so uploads
# here never touch real media.
SEAWEEDFS_ACCESS_KEY_ID=
SEAWEEDFS_SECRET_ACCESS_KEY=
SEAWEEDFS_REGION=us-east-1
SEAWEEDFS_BUCKET=hirfaty
SEAWEEDFS_ENDPOINT=http://hirfaty-staging-seaweedfs:8333
SEAWEEDFS_URL=https://init.hirfaty.com/media
