<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The suite runs in one process, so every test's allocations stack
            up against PHP's default 128M. It was already close: adding a
            dozen tests tipped it over, and the failure surfaces as a fatal
            OOM part-way through rather than as a test failure — with the
            stack pointing at whatever happened to be allocating (usually
            Laravel's debug error page, which is large and renders whenever a
            test provokes an HTTP exception).

            Raising the ceiling rather than chasing the last allocation: the
            figure is a test-runner limit, not a production one.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <!--
          Tests must stay off real infrastructure regardless of the
          developer's local .env — media tests call Storage::fake('public'),
          and controllers resolve their disk via config('filesystems.default'),
          so the default has to be 'public' here or a fake('public') silently
          stops intercepting once .env picks a different default (e.g. seaweedfs).
        -->
        <env name="FILESYSTEM_DISK" value="public"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!--
            Fixed, fake Payzone credentials, whatever the developer's .env
            holds. Card is the only way to pay, so checkout is closed without
            them; nothing here ever reaches Payzone — tests confirm a payment
            with confirmCardPayment() (tests/Pest.php).
        -->
        <env name="PAYZONE_MERCHANT_ACCOUNT" value="hirfaty_Test"/>
        <env name="PAYZONE_SECRET_KEY" value="test-secret"/>
        <env name="PAYZONE_NOTIFICATION_KEY" value="test-notify"/>
        <env name="PAYZONE_PAYWALL_URL" value="https://payment-sandbox.payzone.ma/pwv4/launch"/>
        <env name="PAYZONE_CALLBACK_BASE_URL" value=""/>
        <!--
            Currency lookups are off by default under test. Both services call
            out to the network, and the display currency is resolved on every
            page that renders a price — left on, the suite would make a live
            request per test, which is slow, flaky and dependent on someone
            else's uptime. Off, they fall back to config/currency.php's rates
            and to the base currency, which is what most tests want anyway.

            CurrencyTest re-enables them per test and fakes the HTTP.
        -->
        <env name="CURRENCY_RATES_ENABLED" value="false"/>
        <env name="CURRENCY_GEO_ENABLED" value="false"/>
    </php>
</phpunit>
