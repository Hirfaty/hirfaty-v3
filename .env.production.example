# Copy to `.env` on the VPS (`cp .env.production.example .env`), fill in the
# blanks, then run `make prod-key-generate` once. This file is consumed by
# docker-compose.prod.yml via `env_file: .env` for the app/queue/scheduler
# containers, so DB_HOST/SEAWEEDFS_ENDPOINT use the compose service names
# ("db", "seaweedfs"), not 127.0.0.1.

APP_NAME=Hirfaty
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://init.hirfaty.com
APP_DOMAIN=init.hirfaty.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=hirfaty
DB_USERNAME=hirfaty
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=init.hirfaty.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=seaweedfs
QUEUE_CONNECTION=database

CACHE_STORE=database

# Resend (config/mail.php + config/services.php already wire this up; needs
# `resend/resend-php` in composer.json, added alongside this template).
# MAIL_FROM_ADDRESS must be on a domain verified in the Resend dashboard.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="hello@hirfaty.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

AUTH_DEFAULT_PASSWORD=

GLOBAL_DELIVERY_FEE=20

# SeaweedFS (S3-compatible). ENDPOINT is the internal container URL used by
# the app for uploads; URL is the public, browser-facing URL proxied by
# nginx's /media/ location (see docker/app/nginx-ssl.conf) so media is
# served over the same HTTPS domain.
SEAWEEDFS_ACCESS_KEY_ID=
SEAWEEDFS_SECRET_ACCESS_KEY=
SEAWEEDFS_REGION=us-east-1
SEAWEEDFS_BUCKET=hirfaty
SEAWEEDFS_ENDPOINT=http://seaweedfs:8333
SEAWEEDFS_URL=https://init.hirfaty.com/media
